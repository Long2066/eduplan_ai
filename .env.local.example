# Copy file này thành .env.local rồi điền API key thật.
# Không chia sẻ hoặc commit file .env.local.

OPENAI_API_KEY=your_openai_api_key_here
GENERATION_PIPELINE_MODE=legacy
# Client va server phai cung la staged moi bat quy trinh moi tren giao dien.
NEXT_PUBLIC_GENERATION_PIPELINE_MODE=legacy
# Canary server-side. Empty means no account can use staged; "*" enables everyone.
GENERATION_STAGED_ALLOWLIST=
# Emergency rollback without removing the allowlist.
GENERATION_STAGED_KILL_SWITCH=false
GENERATION_JOB_TTL_HOURS=168
GENERATION_STEP_TIMEOUT_MS=150000
OPENAI_OCR_MODEL=gpt-5.6-luna
OPENAI_OCR_FALLBACK_MODEL=gpt-4o-mini
OPENAI_OCR_REASONING_EFFORT=none
OPENAI_OCR_MAX_OUTPUT_TOKENS=12000
OPENAI_OCR_REQUEST_TIMEOUT_MS=60000
OPENAI_OCR_BATCH_SIZE=3
OPENAI_REASONING_EFFORT=medium
OPENAI_REQUEST_TIMEOUT_MS=240000
GENERATION_SOFT_TIMEOUT_MS=270000
MIN_PERIOD_REPAIR_BUDGET_MS=70000
MIN_QUALITY_REPAIR_BUDGET_MS=85000

# Firebase Admin SDK / Firestore
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=unihubhg-tnu
FIREBASE_DATABASE_ID=(default)
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Firebase Web App config for Authentication
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id_here
# Optional. Only set this if the domain is added in Firebase Authentication > Settings > Authorized domains.
# NEXT_PUBLIC_FIREBASE_AUTH_ACTION_CONTINUE_URL=https://your-domain.example/

# Plan-based AI routing
FREE_OPENAI_MODEL=gpt-5.4-mini
FREE_OPENAI_FALLBACK_MODEL=gpt-5.4-mini
FREE_OPENAI_REASONING_EFFORT=low
# Free chỉ nâng model khi giáo án thực sự cần repair sau kiểm định.
FREE_REPAIR_MODEL=gpt-5.6-terra
FREE_REPAIR_FALLBACK_MODEL=gpt-5.4-mini
FREE_REPAIR_REASONING_EFFORT=medium
FREE_REPAIR_TIMEOUT_MS=60000
FREE_REPAIR_MAX_OUTPUT_TOKENS=12000
PLUS_MODEL=gpt-5.6-terra
PLUS_FALLBACK_MODEL=gpt-5.4-mini
PLUS_FALLBACK_REASONING_EFFORT=low
PLUS_FALLBACK_TIMEOUT_MS=60000
PLUS_FALLBACK_MAX_OUTPUT_TOKENS=12000
PLUS_BLUEPRINT_REASONING_EFFORT=low
PLUS_DETAIL_REASONING_EFFORT=low
PLUS_REPAIR_REASONING_EFFORT=medium
PLUS_BLUEPRINT_TIMEOUT_MS=90000
PLUS_DETAIL_TIMEOUT_MS=90000
PLUS_REPAIR_TIMEOUT_MS=60000
PLUS_BLUEPRINT_MAX_OUTPUT_TOKENS=12000
PLUS_DETAIL_MAX_OUTPUT_TOKENS=16000
PLUS_REPAIR_MAX_OUTPUT_TOKENS=12000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Firebase Storage (avatar và private payment bill uploads)
# Dự án Firebase mới thường dùng your_project_id.firebasestorage.app; dự án cũ có thể dùng your_project_id.appspot.com.
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Bank transfer checkout and automatic proof checks
PAYMENT_PROVIDER=payos
BANK_NAME=Your bank
BANK_ACCOUNT_NAME=YOUR ACCOUNT NAME
BANK_ACCOUNT_NUMBER=0000000000
BANK_QR_IMAGE_URL=

# payOS automatic VietQR checkout. Keep all three credentials server-only.
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_API_BASE_URL=https://api-merchant.payos.vn
PAYOS_BANK_NAME=KienlongBank
PAYOS_WEBHOOK_URL=https://eduplan-ai.id.vn/api/payments/payos/webhook
PAYOS_RETURN_URL=https://eduplan-ai.id.vn/?payment=success
PAYOS_CANCEL_URL=https://eduplan-ai.id.vn/?payment=cancelled
PAYMENT_CHECKOUT_TTL_MINUTES=30
PAYMENT_TIME_WINDOW_BEFORE_MINUTES=5
PAYMENT_TIME_WINDOW_AFTER_MINUTES=30
SUBSCRIPTION_DAYS=30
TOPUP_MIN_AMOUNT_VND=25000
CREDIT_PRICE_VND=1000
IP_HASH_SALT=replace_with_a_long_random_secret

# Protects the daily expired generation cleanup route on Vercel.
CRON_SECRET=replace_with_a_long_random_cron_secret
